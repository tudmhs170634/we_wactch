model Video {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  videoUrl     String
  thumbnailUrl String?
  duration     Float
  size         BigInt
  ownerId      String   @db.Uuid
  createdAt    DateTime @default(now())
  videoKey     String
  isActive     Boolean  @default(false)
  rooms        Room[]   @relation("VideoInRooms")
  owner        User     @relation("UserVideos", fields: [ownerId], references: [id], onDelete: Cascade)
}
