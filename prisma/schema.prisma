generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String    @db.VarChar(255)
  slug      String    @unique @db.VarChar(255)
  type      roomType? @default(private)
  hostId    String?   @db.Uuid
  videoId   String?   @db.Uuid
  password  String?   @db.VarChar(100)
  maxUsers  Int?      @default(5)
  isActive  Boolean?  @default(true)
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  User      User?     @relation(fields: [hostId], references: [id], onUpdate: NoAction)
  Video     Video?    @relation(fields: [videoId], references: [id], onUpdate: NoAction)
}

model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String    @unique @db.VarChar(255)
  username  String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  avatarUrl String?
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  Room      Room[]
  Video     Video[]
}

model Video {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String    @db.VarChar(255)
  description  String?
  videoUrl     String
  thumbnailUrl String?
  duration     Float
  size         BigInt
  ownerId      String?   @db.Uuid
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  Room         Room[]
  User         User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum memberRole {
  host
  viewer
}

enum roomType {
  private
  public
}
